        <item name="android:windowLightStatusBar">true</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.YCT.AutoCompleteTextView</item>
        <item name="buttonStyle">@style/Widget.YCT.Button</item>
        <item name="checkboxStyle">@style/Widget.YCT.CheckBox</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorPrimary">@android:color/holo_blue_bright</item>
        <item name="colorPrimaryVariant">@android:color/holo_blue_light</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="editTextStyle">@style/Widget.YCT.EditText</item>
        <item name="fontFamily">@font/msyh</item>
        <item name="radioButtonStyle">@style/Widget.YCT.RadioButton</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
